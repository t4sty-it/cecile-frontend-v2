{
  "name": "cecile-frontend-v2",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:watch": "bun scripts/lint-watch.ts",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "parser": "peggy --plugin ./node_modules/ts-pegjs/dist/tspegjs.js -o ./src/lib/lang/parser.ts --cache ./src/lib/lang/grammar.pegjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-reconciler": "^0.29.0",
    "react-router-dom": "^6.21.2",
    "sass": "^1.105.1"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/bun": "latest",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-reconciler": "^0.28.8",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17.13.0",
    "marked": "^18.0.14",
    "peggy": "^3.0.2",
    "ts-pegjs": "^4.2.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8",
    "vite": "^8.3.2"
  }
}
